# Local infra (infra/docker-compose.yml) — mirrors those service definitions exactly.

DATABASE_URL=postgresql://reelcast:reelcast@localhost:5432/reelcast

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=reelcast
# Public origin the browser reads manifests/segments/thumbnails from — distinct from
# S3_ENDPOINT (the SDK's signing endpoint). See docs/tasks/TASK-web-playback-ui.md §2.2.
S3_PUBLIC_BASE_URL=http://localhost:9000/reelcast

# Path to the compiled Go transcode binary — apps/worker (the BullMQ shim)
# spawns this per job. Build it with `go build -o bin/transcode ./cmd/transcode`
# from worker/.
GO_WORKER_BIN=./worker/bin/transcode

# apps/api (see apps/api/.env)
PORT=3001
WEB_ORIGIN=http://localhost:3000

# apps/web (see apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001
