{
  "name": "reelcast",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "build:worker": "cd worker && go build -o bin/transcode ./cmd/transcode",
    "dev": "concurrently -n api,worker,web -c blue,yellow,green \"pnpm --filter api start:dev\" \"pnpm --filter worker start:dev\" \"pnpm --filter web dev\"",
    "dev:all": "pnpm infra:up && pnpm build:worker && pnpm dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
