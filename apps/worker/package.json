{
  "name": "worker",
  "version": "0.0.1",
  "description": "BullMQ shim for the hls-transcode queue — holds the job lock and spawns the Go transcode binary. See docs/tasks/TASK-hls-worker.md §2.1/§2.2.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "tsx --env-file=.env src/main.ts",
    "start:dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc",
    "start:prod": "node --env-file=.env dist/main.js",
    "test:e2e": "tsx --test --test-concurrency=1 --env-file=.env test/**/*.e2e.test.ts"
  },
  "dependencies": {
    "bullmq": "^6.1.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.21.0",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
